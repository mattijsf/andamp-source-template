<?xml version="1.0" encoding="utf-8"?>
<!--
  A minimal music source for Andamp.

  The service answers the bind action, which is how the player finds this
  source. The settings activity answers the settings action, which the player's
  Preferences opens. Both are exported because the caller is another package.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The only permission declared here; the SDK adds ACCESS_NETWORK_STATE.
      The source plays no audio itself: what it decodes goes to the player
      through a pipe. It has no foreground service and no wake lock.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Source">

        <service
            android:name="nl.mattix.andamp.pack.template.SourceService"
            android:exported="true">
            <intent-filter>
                <action android:name="nl.mattix.andamp.source.BIND" />
            </intent-filter>
            <!--
              Optional: the mark Andamp shows beside this source's songs when the
              listener has more than one source. Point MARK at a one-color drawable
              and MARK_PIXELS at a string array of pixel art (# for ink, . for none,
              up to nine rows of nine), and remove this comment around them.
              Without them Andamp uses the shape of the launcher icon, or else the
              first letter of SourceIdentity.LABEL.

            <meta-data
                android:name="nl.mattix.andamp.source.MARK"
                android:resource="@drawable/andamp_mark" />
            <meta-data
                android:name="nl.mattix.andamp.source.MARK_PIXELS"
                android:resource="@array/andamp_mark_pixels" />
            -->
        </service>

        <activity
            android:name="nl.mattix.andamp.pack.template.SettingsActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="nl.mattix.andamp.source.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- the "Additional settings in the app" button on the phone's App info page -->
            <intent-filter>
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          The icon in the app list. The alias is declared disabled and is
          enabled at runtime by PackLauncherEntry in source-common, so that the
          listener can remove the icon. Its name has to equal
          SourceIdentity.LAUNCHER_ALIAS.
        -->
        <activity-alias
            android:name="nl.mattix.andamp.pack.template.LauncherEntry"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name"
            android:targetActivity="nl.mattix.andamp.pack.template.SettingsActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
